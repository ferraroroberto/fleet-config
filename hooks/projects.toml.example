cwd_prefix       = "E:/automation/grocery-shopping-automation"
webapp_port      = 8502
browser_scheme   = "https"
tray_cmd         = "tray.bat"
api_version_path = "/api/version"
# No restart_cmd: its tray manager lives in app/tray/, and its own CLAUDE.md
# declares `tray.bat --restart` as the recipe.

[illustration-color-edit]
cwd_prefix = "E:/automation/illustration-color-edit"

[inspiration-system]
cwd_prefix = "E:/automation/inspiration-system"

[life-os]
cwd_prefix      = "E:/automation/life-os"
# Conversation capture + index. "skills" routing writes per-skill
# conversations/ dirs under skills_dir, picked by the marker a skill's Step 0
# writes; the default "flat" routing keeps one conversations/ per project.
capture         = true
capture_harnesses = ["claude", "codex"]
capture_routing = "skills"
skills_dir      = ".claude/skills"
# Its channel sessions send household documents without a per-send prompt.
telegram_file_guard = true
# Every skill's private context lives under .claude/; the bulk-dir guard must keep it.
backup_include  = [".claude"]
active_marker   = ".active-skill"
# What every skill's bootstrap auto-loads, measured by /context-audit.
bootstrap_shared   = ["identity/who-i-am.md", "identity/current-focus.md"]
bootstrap_skill    = ["{skill}/description.md", "{skill}/conversations/index.md"]
bootstrap_sections = ["Step 1"]
# The conversation index loads head-only; the audit reads that cap from the file declaring it.
bootstrap_line_caps = { "{skill}/conversations/index.md" = ".claude/skills/_shared/bootstrap.md" }

