# ---- Fleet-wide settings ---------------------------------------------------------

[global]
# Ports no port-scoped kill may touch: 8000 the LLM hub, 8090 whisper-server,
# 8446 the app-launcher session-host (killing it kills every live session).
never_kill_ports = [8000, 8090, 8446]
telegram_chat           = "-1004408175579"   # fallback when a category chat is unset
telegram_chat_attention = "-1004408175579"   # come-look pings
telegram_chat_log       = "-1004387099086"   # activity record and weekly digests

# Fleet scope. A repo listed here is dormant: out of every fleet-wide run and
# off the architecture and config maps. Hooks still know it, and a run that
# names it explicitly still reaches it. Keep one repo per line; flip one with
#   skills/_lib/fleet_status.py set <repo> active|dormant
# which edits this machine's file only. See docs/fleet-scope.md.
architecture_ignore = [
  "externalrisk",           # out of scope for the personal-fleet map
  "arboldelossuenos",       # out of scope for the personal-fleet map
]

# ---- Daily fleet-private backup ------------------------------------------------
#
# Stays the LAST table: a TOML table header claims every bare key after it, so
# a [global] key written below this line would silently move into [backup].
# It is a table of its own, with no cwd_prefix, so the fleet enumerators never
# see it. Per-repo overrides live in each repo's table above.
[backup]
source_root      = "E:/automation"
# Singular `backup`: a sibling `backups` folder one letter away is what gets
# restored from by mistake under pressure.
dest             = "C:/Users/rober/backup/fleet-private"
transcripts_src  = "~/.claude/projects"
transcripts_dest = "E:/backup/claude-transcripts"
codex_sessions_src  = "~/.codex"
codex_sessions_dest = "E:/backup/codex-sessions"
# The always-on services' SQLite databases live outside every working tree, so
# they get their own leg: snapshotted with SQLite's online backup API (never a
# byte copy of a live WAL), exempt from max_file_mb, and written to another
# volume (a same-volume snapshot is refused).
runtime_data_src  = "C:/sqlite"
runtime_data_dest = "E:/backup/fleet-runtime-data"
keep_daily       = 14
keep_weekly      = 8
max_file_mb      = 10
# The bulk-directory guard: a top-level directory whose surviving subtree
# passes this size is excluded whole and named in the run report, because
# gitignored generated output would otherwise fill the snapshot.
bulk_dir_mb      = 25
# A snapshot older than this reads `stale` from --check-freshness (the job is daily).
freshness_max_hours = 48
