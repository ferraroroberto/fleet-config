# Fleet registry: one table per repo, read by the hooks and the fleet skills.
#
# hooks/projects.toml is machine-local and gitignored; this tracked
# projects.toml.example is its template. install.ps1 seeds the local file from
# it on a fresh clone. A new repo or a new key goes into BOTH files in the same
# PR (the acceptance run fails when their repo tables differ). Switching a repo
# in or out of fleet runs edits only the local file (see [global] below).
#
# Hook code stays generic; anything project-specific lives here. A hook picks
# the project whose `cwd_prefix` is the longest prefix of the session's cwd.
# Paths use forward slashes (cross-shell safe on Windows). No secrets: the
# Telegram bot token and real hostnames live in the ignored .env or the
# agent's env, never here.
#
# ---- Optional per-project keys ---------------------------------------------
#
#   webapp_port = 8445 + browser_scheme = "https"
#     Every table with a webapp_port declares its scheme. Agent-owned
#     Playwright sessions open <scheme>://127.0.0.1:<port> and bypass
#     certificate errors for that loopback origin only. A normal browser opens
#     https://$FLEET_BROWSER_HOST:<port> so the Tailscale certificate matches;
#     FLEET_BROWSER_HOST is a hostname kept in the agent's env.
#
#   restart_cmd = '...'
#     The webapp restart restart_and_verify_webapp.py prefers over "kill the
#     port PID and relaunch tray_cmd". Tray-owned apps need it: an idempotent
#     tray.bat no-ops while the tray lives, while the one-liner below spawns a
#     fresh uvicorn the tray adopts and never touches the :8446 session-host.
#
#   telegram_chat / telegram_chat_attention / telegram_chat_log = "-100..."
#     Where pings go. A ping is "attention" (come look: blocked, awaiting
#     input, ready to validate) or "log" (filed, shipped, merged, digests);
#     an unset category chat falls back to telegram_chat. Per project or in
#     [global]; with neither set, pings are silent. Use a supergroup or
#     channel (-100...): Telegram rewrites a basic group's id when it upgrades
#     it, and every send to the old id fails.
#
#   board_url = "https://<pc>.<tailnet>.ts.net:8445"
#     Adds an "Open on the Board" deep link to needs-you pings. Set the real
#     URL through the FLEET_BOARD_URL env var instead: this repo is public.
#
#   chief_handover = true
#     This project hosts the standing fleet chief; its run log is handed back
#     on SessionStart.
#
#   telegram_file_guard = true
#     A Telegram reply carrying files goes only to the private chat of the
#     person whose message triggered the turn.
#
#   backup = false | backup_exclude | backup_include | backup_always_include |
#   backup_include_globs
#     Per-repo overrides of the daily backup; see [backup] at the end.

# ---- Projects with a running service -----------------------------------------

[app-launcher]
cwd_prefix          = "E:/automation/app-launcher"
webapp_port         = 8445
browser_scheme      = "https"
session_host_port   = 8446
gate_trigger_globs  = ["app/webapp/**", "src/launcher.py", "src/session_host*.py"]
gate_cmd            = "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File scripts/verify-before-ship.ps1"
tray_cmd            = "tray.bat"
restart_cmd         = '& .\.venv\Scripts\python.exe -c "from app.webapp.manager import WebappManager; WebappManager().start(wait=True)"'
api_version_path    = "/api/version"

[photo-ocr]
cwd_prefix          = "E:/automation/photo-ocr"
webapp_port         = 8444
browser_scheme      = "https"
gate_trigger_globs  = ["app/webapp/**"]
gate_cmd            = "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File scripts/verify-before-ship.ps1"
tray_cmd            = "tray.bat"
restart_cmd         = '& .\.venv\Scripts\python.exe -c "from app.webapp.manager import WebappManager; WebappManager().start(wait=True)"'
api_version_path    = "/api/version"

[voice-transcriber]
cwd_prefix          = "E:/automation/voice-transcriber"
webapp_port         = 8443
browser_scheme      = "https"
gate_cmd            = "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File scripts/verify-before-ship.ps1"
tray_cmd            = "tray.bat"
restart_cmd         = '& .\.venv\Scripts\python.exe -c "from app.webapp.manager import WebappManager; WebappManager().start(wait=True)"'
api_version_path    = "/api/version"

[home-automation]
cwd_prefix          = "E:/automation/home-automation"
# _local/ mixes hand-written notes with a multi-GB VM tree and UPS captures;
# dropping the two generated subtrees keeps the notes under the bulk-dir guard.
backup_exclude      = ["_local/vm/**", "_local/nut/**"]
# The automation event history is security-relevant, so it is exempt from the
# size cap, and its two logs from the *.log deny-glob.
backup_always_include = ["webapp/telemetry.sqlite3"]
backup_include_globs  = ["webapp.log", "watchdog.log"]
webapp_port         = 8447
browser_scheme      = "https"
tray_cmd            = "tray.bat"
restart_cmd         = '& .\.venv\Scripts\python.exe -c "from app.webapp.manager import WebappManager; WebappManager().start(wait=True)"'
api_version_path    = "/api/version"

[local-llm-hub]
cwd_prefix          = "E:/automation/local-llm-hub"
webapp_port         = 8000
browser_scheme      = "http"
whisper_port        = 8090
# The hub answers its build identity under /admin/.
api_version_path    = "/admin/api/version"
gate_cmd            = "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File scripts/verify-before-ship.ps1"
tray_cmd            = "tray.bat"
# This repo owns the agent-CLI subprocess wrapper, so hub_bypass_warn stays quiet here.
is_hub              = true

