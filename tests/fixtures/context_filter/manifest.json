{
  "cases": [
    {
      "name": "pytest failure",
      "command": "pytest",
      "fixture": "pytest_failure.txt",
      "min_reduction_pct": 35,
      "must_contain": ["FAILED tests/test_billing.py::test_invoice_total", "AssertionError", "tests/test_billing.py:42"]
    },
    {
      "name": "pytest multi-failure",
      "command": "pytest tests",
      "fixture": "pytest_multi_failure.txt",
      "min_reduction_pct": 50,
      "must_contain": ["FAILED tests/test_billing.py::test_invoice_total", "FAILED tests/test_reports.py::test_report_totals", "tests/test_billing.py:87", "AssertionError"]
    },
    {
      "name": "git log oneline (long history)",
      "command": "git log --oneline -200",
      "fixture": "git_log_oneline.txt",
      "min_reduction_pct": 50,
      "must_contain": ["a1b2c00 feat: add weekly digest (#200)", "earlier commits omitted"]
    },
    {
      "name": "npm success",
      "command": "npm test",
      "fixture": "npm_success.txt",
      "min_reduction_pct": 55,
      "must_contain": ["all visible test suites passed", "72 PASS lines"]
    },
    {
      "name": "git status (every distinct path survives)",
      "command": "git status --short",
      "fixture": "git_status.txt",
      "min_reduction_pct": 0,
      "must_contain": [
        "modified: hooks/context_filter.py",
        "new file: tests/fixtures/context_filter/manifest.json",
        "modified: README.md",
        "modified: tests/run_acceptance.py",
        "modified: hooks/context_filter_hook.py",
        "tests/fixtures/context_filter/git_status.txt",
        "tests/fixtures/context_filter/npm_success.txt",
        "tests/fixtures/context_filter/pytest_failure.txt",
        "tests/fixtures/context_filter/repetitive_log.txt",
        "tests/fixtures/context_filter/large_json.txt"
      ]
    },
    {
      "name": "repetitive log (cat is verbatim, never an extract)",
      "command": "cat app.log",
      "fixture": "repetitive_log.txt",
      "min_reduction_pct": 0,
      "must_contain": [
        "database retry exhausted",
        "Traceback (most recent call last)",
        "database retry attempt=1",
        "database retry attempt=2",
        "2f79f7cf-1111-4111-8111-8e5200000001",
        "2f79f7cf-1111-4111-8111-8e5200000012",
        "File \"app/db.py\", line 88, in connect",
        "TimeoutError: database connection timed out"
      ]
    },
    {
      "name": "large json",
      "command": "gh pr list --json number,title,author,labels",
      "fixture": "large_json.txt",
      "min_reduction_pct": 70,
      "must_contain": ["JSON array: 12 items", "author", "labels"]
    }
  ]
}
