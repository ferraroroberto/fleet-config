{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/pre_commit_no_ai_trailer.py",
            "timeout": 15,
            "statusMessage": "Checking commit message"
          },
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/secret_scan_guard.py",
            "timeout": 15,
            "statusMessage": "Checking staged secrets"
          },
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/bash_cmdexe_syntax_guard.py",
            "timeout": 15,
            "statusMessage": "Checking cmd.exe syntax"
          },
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/bash_windows_path_guard.py",
            "timeout": 15,
            "statusMessage": "Checking Windows paths"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/safe_kill_guard.py",
            "timeout": 15,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/venv_discipline.py",
            "timeout": 15,
            "statusMessage": "Checking venv usage"
          },
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/context_filter_hook.py",
            "timeout": 15,
            "statusMessage": "Checking context filter"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "E:/automation/fleet-config/.venv/Scripts/python.exe C:/Users/rober/.codex/hooks/py_syntax_check.py",
