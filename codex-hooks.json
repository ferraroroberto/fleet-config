{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/pre_commit_no_ai_trailer.py",
            "timeout": 15,
            "statusMessage": "Checking commit message"
          },
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/secret_scan_guard.py",
            "timeout": 15,
            "statusMessage": "Checking staged secrets"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/safe_kill_guard.py",
            "timeout": 15,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/venv_discipline.py",
            "timeout": 15,
            "statusMessage": "Checking venv usage"
          },
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/context_filter_hook.py",
            "timeout": 15,
            "statusMessage": "Checking context filter"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rober/AppData/Local/Python/bin/python.exe C:/Users/rober/.codex/hooks/py_syntax_check.py",
            "timeout": 15,
            "statusMessage": "Checking Python syntax"
          }
        ]
      }
    ]
  }
}
