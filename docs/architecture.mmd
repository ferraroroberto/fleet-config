%% docs/architecture.mmd — fleet-config's own internal structure.
%% Hand-authored, not generated — unlike architecture/system-map.mmd (the
%% mechanically-aggregated fleet-wide picture), this repo's own internal shape
%% is semantic and can't be crawled the same way. Update this diagram in the
%% same PR as any material structural change (a new skill tier, a hook added
%% or moved, a script relocated) — same anti-staleness contract as a repo's
%% own `.fleet.toml` `description` field. See global-CLAUDE.md's "Every repo
%% carries a `.fleet.toml`" section for the general convention.

flowchart TB
  subgraph install["install.ps1 / uninstall.ps1"]
    INSTALL["junctions: hooks/, skills/, commands/, pi/extensions/, tray/\nsymlinks: global-CLAUDE.md, design.md, design.dark.md,\nstatusline-command.ps1, codex-hooks.json"]
  end

  subgraph homes["Agent homes"]
    CLAUDE["~/.claude (Claude Code)"]
    CODEX["~/.codex (Codex)"]
    PIHOME["~/.pi/agent (Pi)"]
    COPILOT["~/.copilot (Copilot CLI)"]
  end

  INSTALL --> CLAUDE
  INSTALL --> CODEX
  INSTALL --> PIHOME
  INSTALL --> COPILOT

  subgraph hooks["hooks/ — junctioned into Claude + Codex only"]
    LIBPY["_lib.py\nproject detection, stdin-JSON, projects.toml loader"]
    PROJECTS["projects.toml\nper-project ports/gates/never-kill ports"]
    RUNHOOK["run-hook.ps1 — Claude Code shim (Git Bash routes through it)"]
    HOOKFILES["pre_commit_no_ai_trailer · secret_scan_guard · safe_kill_guard ·\nvenv_discipline · py_syntax_check · notify_on_idle · session_state · …"]
    SLACKPY["slack_notify.py -> notify_complete.py -> work_summary.py"]
  end
  hooks --> CLAUDE
  hooks --> CODEX
  HOOKFILES --> LIBPY
  HOOKFILES --> PROJECTS
  RUNHOOK --> HOOKFILES

  subgraph tray["tray/ — junctioned into ~/.claude/tray (fleet-config#153)"]
    TRAYPS1["tray_lifecycle.ps1\nONE machine-local copy; every sister tray.bat calls it by path\ncanonical source: project-scaffolding"]
  end
  tray --> CLAUDE

  subgraph gskills["skills/ — GLOBAL tier (every session, every repo)"]
    ISSUEADD["issue-add"] --> ISSUESTART["issue-start"] --> ISSUEFINISH["issue-finish"]
    ISSUEEXTRA["issue-batch · issue-finish-batch · issue-triage · issue-yolo"]
    OTHERGLOBAL["codebase-audit · design-sync · handoff-commit · screen"]
    PROPVENDORED["propagate-vendored\n[vendored] manifest fan-out + dry-run drift report"]
    LIB["_lib/ — worktree_claim.py · active_issue.py · ux_surface.py · browser_verify.py ·\naudit_issue.py · cert_drift.py · rate_gate.py · dirty_tree_check.py ·\ndesign_lint.py · git_run.py · snapshot_diff.py · fleet_repo_scan.py · vendored_drift.py"]
  end
  gskills --> CLAUDE
  gskills --> CODEX
  gskills --> PIHOME
  gskills --> COPILOT
  ISSUESTART --> LIB
  ISSUEFINISH --> LIB
  ISSUEEXTRA --> LIB
  OTHERGLOBAL --> LIB
  PROPVENDORED --> LIB

  subgraph fskills[".claude/skills/ — FLEET-ONLY tier (cwd-scoped to fleet-config)"]
    SYSTEMMAP["system-map\nbuild_data.py · render.py · render_mermaid.py · whatchanged.py"]
    AUDITFLEET["audit-fleet"] --> CLEANUPFLEET["cleanup-fleet\n(attended, single-bucket, human-gated)"]
    CLEANUPFLEET --> CLEANUPFLEETALL["cleanup-fleet-all\n(unattended, all-bucket, agent-validated)"]
    CONTEXTAUDIT["context-audit"] --> CONTEXTPURGE["context-purge\ncheck.py · gate.py"]
    CONFIGMAP["config-map"]
    OTHERFLEET["insights-weekly · learning-log"]
  end
  fskills -.->|cwd-scoped, Claude Code only| CLAUDE
  AUDITFLEET -->|invokes per repo| OTHERGLOBAL
  CLEANUPFLEET -->|fans out fixes for| OTHERGLOBAL
  CLEANUPFLEET --> ISSUEEXTRA

  subgraph fworkflows[".claude/workflows/ — Workflow-tool scripts, no Bash/filesystem access"]
    CLEANUPFLEETALLJS["cleanup-fleet-all.js\nbuild -> validate -> execute per issue,\ndeterministic retry/escalate gate (max 2 rounds)"]
  end
  CLEANUPFLEETALL -->|invokes + polls TaskOutput to completion| CLEANUPFLEETALLJS
  CLEANUPFLEETALLJS -->|build/execute agents reuse| ISSUEEXTRA

  ARCH["architecture/\nfleet.data.js · system-map.{html,png,mmd} · config.data.js · ARCHITECTURE.md"]
  GCMDFILE["global-CLAUDE.md"]
  SYSTEMMAP --> ARCH
  SYSTEMMAP -->|marked block| GCMDFILE
  CONFIGMAP --> ARCH
  CONTEXTAUDIT -->|measures| GCMDFILE
  CONTEXTAUDIT -->|measures| gskills
  CONTEXTAUDIT -->|measures| fskills
  CONTEXTPURGE -->|compresses| GCMDFILE
  CONTEXTPURGE -->|compresses| gskills

  subgraph tests["tests/run_acceptance.py"]
    TESTS["hook payload matrix + _lib unit tests +\nsystem-map / config-map drift guards"]
  end
  TESTS --> HOOKFILES
  TESTS --> LIB
  TESTS --> ARCH
