# Copy to .env (gitignored) in this same directory and fill in real values.
# See ../README.md "Configuring the home-automation connection".

# home-automation's real, HTTPS Tailscale URL (not loopback — the button
# should work the same way any other external caller does).
HOME_AUTOMATION_BASE_URL=https://<host>.<tailnet>.ts.net:8447

# Bearer token from home-automation/scripts/gen_token.py.
HOME_AUTOMATION_TOKEN=

# facilitation-suite (fleet-config#1006) — runs on this same PC, which needs
# no token. Both lines are optional: the default is shown. Once the suite serves
# HTTPS (a Tailscale cert) it answers only there — use its tailnet name:
#   FACILITATION_SUITE_BASE_URL=https://<this PC>.<tailnet>.ts.net:8449
# FACILITATION_SUITE_BASE_URL=http://127.0.0.1:8449
# FACILITATION_SUITE_TOKEN=
