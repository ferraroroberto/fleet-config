{
  "name": "fleet-coding-stream-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Source-controlled Elgato Stream Deck plugin for the Fleet Coding control surface (fleet-config#370).",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "icon": "node scripts/generate-plugin-icon.mjs",
    "prebuild": "npm run sync-assets",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mts\"",
    "validate": "streamdeck validate com.ferraroroberto.fleetcoding.sdPlugin",
    "pack": "streamdeck pack com.ferraroroberto.fleetcoding.sdPlugin --output dist",
    "verify": "npm run typecheck && npm run test && npm run sync-assets && npm run build",
    "package": "npm run validate && npm run pack"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.3",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^24.0.0",
    "rollup": "^4.24.0",
    "smol-toml": "^1.3.1",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3"
  }
}
